Names Default To Here(1);

/******************************************************************************
  PART 1 of 4
  -----------
  In this first quarter of the script, we will:
    1) Open the top-level design table (1596 x 9).
    2) Add placeholders for sub-factors.
    3) Define the six dimension × Z sub-tables:
       - E=L1,Z=L1 => cdf_dim1
       - E=L1,Z=L2 => cdfn_lm_dim1
       - E=L2,Z=L1 => cdf_dim2
       - E=L2,Z=L2 => cdfn_lm_dim2
       - E=L3,Z=L1 => cdf_dim3
       - E=L3,Z=L2 => cdfn_lm_dim3
  We fill each table fully, with no references to "fill similarly."
  We'll handle expansions for (X,Y) and unify everything in later parts.
******************************************************************************/


/******************************************************************************
  STEP 0: OPEN THE TOP-LEVEL DESIGN
  Table must have columns: A,B,G,H,I,X,Y,Z,E
  Each factor has levels like "L1","L2","L3" for E or "L1","L2" for X,Y,Z, etc.
******************************************************************************/
dtTop = Open("/Users/alihashim/Desktop/Online_Academic_Submissions/poec_thesis/design_new_1596.jmp");


/******************************************************************************
  STEP 1: ADD PLACEHOLDER COLUMNS FOR SUB-FACTORS
    We want to measure (C,D,F) dimension-based, plus (N,L,M) if Z=1,
    plus (J,K) if X=1 or Y=1. We'll define them all here:
******************************************************************************/
dtTop << New Column("C", Character, "Nominal");
dtTop << New Column("D", Character, "Nominal");
dtTop << New Column("F", Character, "Nominal");
dtTop << New Column("N", Character, "Nominal");
dtTop << New Column("L", Character, "Nominal");
dtTop << New Column("M", Character, "Nominal");
dtTop << New Column("J", Numeric, "Nominal");
dtTop << New Column("K", Numeric, "Nominal");


/******************************************************************************
  STEP 2: DEFINE SIX DIMENSION × Z SUB-TABLES
    For each combination of E={L1,L2,L3} and Z={L1,L2}, we create a sub-table.

  1) E=L1, Z=L1 => cdf_dim1 => (C1,D1,F1).
  2) E=L1, Z=L2 => cdfn_lm_dim1 => (C1,D1,F1,N1,L1,M1).
  3) E=L2, Z=L1 => cdf_dim2 => (C2,D2,F2).
  4) E=L2, Z=L2 => cdfn_lm_dim2 => (C2,D2,F2,N2,L2,M2).
  5) E=L3, Z=L1 => cdf_dim3 => (C3,D3,F3).
  6) E=L3, Z=L2 => cdfn_lm_dim3 => (C3,D3,F3,N3,L3,M3).

  We fill each table thoroughly with combos. 
******************************************************************************/


/*** (1) E=L1, Z=L1 => cdf_dim1 => (C1,D1,F1) 
     Let's do 2 × 2 × 4 = 16 combos. 
     We store "C1_x", "D1_x", "F1_x" for each. ***/
cdf_dim1 = New Table("cdf_dim1",
  Add Rows(16),
  New Column("C", Character),
  New Column("D", Character),
  New Column("F", Character)
);
idx = 1;
For(c=1, c<=2, c++,
  For(d=1, d<=2, d++,
    For(f=1, f<=4, f++,
      Column(cdf_dim1, "C")[idx] = "C1_"||Char(c);
      Column(cdf_dim1, "D")[idx] = "D1_"||Char(d);
      Column(cdf_dim1, "F")[idx] = "F1_"||Char(f);
      idx++;
    )
  )
);


/*** (2) E=L1, Z=L2 => cdfn_lm_dim1 => (C1,D1,F1,N1,L1,M1)
     We'll do 2 × 2 × 2 × 2 × 2 × 2 = 64 combos, e.g. c=1..2, d=1..2, f=1..2,
     n=1..2, l=1..2, m=1..2 => total 64. ***/
cdfn_lm_dim1 = New Table("cdfn_lm_dim1",
  Add Rows(64),
  New Column("C", Character),
  New Column("D", Character),
  New Column("F", Character),
  New Column("N", Character),
  New Column("L", Character),
  New Column("M", Character)
);
idx=1;
For(c=1, c<=2, c++,
  For(d=1, d<=2, d++,
    For(f=1, f<=2, f++,
      For(n=1, n<=2, n++,
        For(l=1, l<=2, l++,
          For(m=1, m<=2, m++,
            Column(cdfn_lm_dim1, "C")[idx] = "C1_"||Char(c);
            Column(cdfn_lm_dim1, "D")[idx] = "D1_"||Char(d);
            Column(cdfn_lm_dim1, "F")[idx] = "F1_"||Char(f);
            Column(cdfn_lm_dim1, "N")[idx] = "N1_"||Char(n);
            Column(cdfn_lm_dim1, "L")[idx] = "L1_"||Char(l);
            Column(cdfn_lm_dim1, "M")[idx] = "M1_"||Char(m);
            idx++;
))))));


/*** (3) E=L2, Z=L1 => cdf_dim2 => (C2,D2,F2)
     We'll do 2 × 2 × 4 = 16 combos. ***/
cdf_dim2 = New Table("cdf_dim2",
  Add Rows(16),
  New Column("C", Character),
  New Column("D", Character),
  New Column("F", Character)
);
idx=1;
For(c=1, c<=2, c++,
  For(d=1, d<=2, d++,
    For(f=1, f<=4, f++,
      Column(cdf_dim2, "C")[idx] = "C2_"||Char(c);
      Column(cdf_dim2, "D")[idx] = "D2_"||Char(d);
      Column(cdf_dim2, "F")[idx] = "F2_"||Char(f);
      idx++;
    )
  )
);


/*** (4) E=L2, Z=L2 => cdfn_lm_dim2 => (C2,D2,F2,N2,L2,M2)
     We'll do 2 × 2 × 2 × 2 × 2 × 2 = 64 combos. ***/
cdfn_lm_dim2 = New Table("cdfn_lm_dim2",
  Add Rows(64),
  New Column("C", Character),
  New Column("D", Character),
  New Column("F", Character),
  New Column("N", Character),
  New Column("L", Character),
  New Column("M", Character)
);
idx=1;
For(c=1, c<=2, c++,
  For(d=1, d<=2, d++,
    For(f=1, f<=2, f++,
      For(n=1, n<=2, n++,
        For(l=1, l<=2, l++,
          For(m=1, m<=2, m++,
            Column(cdfn_lm_dim2, "C")[idx] = "C2_"||Char(c);
            Column(cdfn_lm_dim2, "D")[idx] = "D2_"||Char(d);
            Column(cdfn_lm_dim2, "F")[idx] = "F2_"||Char(f);
            Column(cdfn_lm_dim2, "N")[idx] = "N2_"||Char(n);
            Column(cdfn_lm_dim2, "L")[idx] = "L2_"||Char(l);
            Column(cdfn_lm_dim2, "M")[idx] = "M2_"||Char(m);
            idx++;
))))));


/*** (5) E=L3, Z=L1 => cdf_dim3 => (C3,D3,F3)
     We'll do 2 × 2 × 4 = 16 combos again. ***/
cdf_dim3 = New Table("cdf_dim3",
  Add Rows(16),
  New Column("C", Character),
  New Column("D", Character),
  New Column("F", Character)
);
idx=1;
For(c=1, c<=2, c++,
  For(d=1, d<=2, d++,
    For(f=1, f<=4, f++,
      Column(cdf_dim3, "C")[idx] = "C3_"||Char(c);
      Column(cdf_dim3, "D")[idx] = "D3_"||Char(d);
      Column(cdf_dim3, "F")[idx] = "F3_"||Char(f);
      idx++;
    )
  )
);


/*** (6) E=L3, Z=L2 => cdfn_lm_dim3 => (C3,D3,F3,N3,L3,M3)
     We'll do 2 × 2 × 2 × 2 × 2 × 2 = 64 combos. ***/
cdfn_lm_dim3 = New Table("cdfn_lm_dim3",
  Add Rows(64),
  New Column("C", Character),
  New Column("D", Character),
  New Column("F", Character),
  New Column("N", Character),
  New Column("L", Character),
  New Column("M", Character)
);
idx=1;
For(c=1, c<=2, c++,
  For(d=1, d<=2, d++,
    For(f=1, f<=2, f++,
      For(n=1, n<=2, n++,
        For(l=1, l<=2, l++,
          For(m=1, m<=2, m++,
            Column(cdfn_lm_dim3, "C")[idx] = "C3_"||Char(c);
            Column(cdfn_lm_dim3, "D")[idx] = "D3_"||Char(d);
            Column(cdfn_lm_dim3, "F")[idx] = "F3_"||Char(f);
            Column(cdfn_lm_dim3, "N")[idx] = "N3_"||Char(n);
            Column(cdfn_lm_dim3, "L")[idx] = "L3_"||Char(l);
            Column(cdfn_lm_dim3, "M")[idx] = "M3_"||Char(m);
            idx++;
))))));

/******************************************************************************
  ***END OF PART 1***
  This first quarter:
    - Opens dtTop
    - Adds placeholders for (C,D,F,N,L,M,J,K)
    - Defines the 6 dimension×Z sub-tables fully, each with combos.
  We have NOT joined anything or created expansions for (X=1,Y=1). 
  That will come in the next script parts (2..4).
******************************************************************************/ 

Names Default To Here(1);

/******************************************************************************
  PART 2 of 4
  -----------
  In this second quarter of the script, we:
   1) Create sub-tables for (J,K) expansions for X=1 or Y=1.
   2) Implement expansions for E=L1:
      - Scenario (E=L1,Z=L1) => cross with cdf_dim1, then expansions for (X,Y).
      - Scenario (E=L1,Z=L2) => cross with cdfn_lm_dim1, then expansions for (X,Y).
   3) Unify scenario1 + scenario2 plus dtBaseAll => dtPartial1.
   We do NOT yet handle E=L2 or E=L3, nor final unify. That comes in Parts 3 & 4.
******************************************************************************/

/******************************************************************************
  STEP A: CREATE SUB-TABLES FOR (J,K) IF X=1 or Y=1
     We'll do dtJ => 4 combos if (X=1, Y=0) or (X=1, Y= anything),
              dtK => 4 combos if (Y=1, X=0) or (Y=1, X= any),
              dtJK => 16 combos if (X=1, Y=1).
******************************************************************************/
dtJ = New Table("dtJ",
  Add Rows(4),
  New Column("J", Numeric, "Nominal")
);
For(r=1, r<=4, r++,
  Column(dtJ,"J")[r] = r-1;
);

dtK = New Table("dtK",
  Add Rows(4),
  New Column("K", Numeric, "Nominal")
);
For(r=1, r<=4, r++,
  Column(dtK,"K")[r] = r-1;
);

dtJK = New Table("dtJK",
  Add Rows(16),
  New Column("J", Numeric, "Nominal"),
  New Column("K", Numeric, "Nominal")
);
idx=1;
For(j=0, j<4, j++,
  For(k=0, k<4, k++,
    Column(dtJK,"J")[idx] = j;
    Column(dtJK,"K")[idx] = k;
    idx++;
  )
);

/******************************************************************************
  STEP B: CREATE A BASE TABLE => dtBaseAll with no expansions
     (We assume dtTop is already open from Part 1,
      so we do a subset to produce an empty copy.)
******************************************************************************/
dtBaseAll = dtTop << Subset(
  Selected Rows(0),
  Output Table("BaseAll")
);

/******************************************************************************
  STEP C: DEFINE A CARTESIAN JOIN FUNCTION FOR EASE
******************************************************************************/
cartJoin = Function(
  {dtA, dtB, outName},
  Return(
    dtA << Join(
      With(dtB),
      Type("Cartesian"),
      Output Table(outName)
    )
  )
);

/******************************************************************************
  STEP D: SCENARIO 1 => E=L1, Z=L1 => CROSS WITH cdf_dim1 => expansions for X,Y
******************************************************************************/
/*** Subset dtTop => E="L1" & Z="L1" ***/
dtE1Z1_sub = dtTop << Subset(
  Selected Rows(0),
  Rows Where(:E=="L1" & :Z=="L1"),
  Output Table("E1Z1_sub")
);
/*** Join with cdf_dim1 => cdf for (C1,D1,F1). ***/
dtE1Z1_cdf = cartJoin(dtE1Z1_sub, cdf_dim1, "E1Z1_cdf");

/*** Next, expansions for (X,Y):
   - X=L1,Y=L1 => no expansions
   - X=L2,Y=L1 => cross dtJ
   - X=L1,Y=L2 => cross dtK
   - X=L2,Y=L2 => cross dtJK
***/
/* (X=L1,Y=L1) => no expansions */
dtE1Z1_x1y1 = dtE1Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L1"),
  Output Table("E1Z1_x1y1")
);
/* (X=L2,Y=L1) => cross dtJ */
dtE1Z1_x2y1 = dtE1Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L1"),
  Output Table("E1Z1_x2y1")
);
dtE1Z1_x2y1_J = cartJoin(dtE1Z1_x2y1, dtJ, "E1Z1_x2y1_J");

/* (X=L1,Y=L2) => cross dtK */
dtE1Z1_x1y2 = dtE1Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L2"),
  Output Table("E1Z1_x1y2")
);
dtE1Z1_x1y2_K = cartJoin(dtE1Z1_x1y2, dtK, "E1Z1_x1y2_K");

/* (X=L2,Y=L2) => cross dtJK */
dtE1Z1_x2y2 = dtE1Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L2"),
  Output Table("E1Z1_x2y2")
);
dtE1Z1_x2y2_JK = cartJoin(dtE1Z1_x2y2, dtJK, "E1Z1_x2y2_JK");

/*** unify scenario 1 expansions => dtE1Z1_out ***/
dtE1Z1_out = Concatenate(
  dtE1Z1_x1y1,
  dtE1Z1_x2y1_J,
  dtE1Z1_x1y2_K,
  dtE1Z1_x2y2_JK,
  Output Table("E1Z1_out"),
  Append To First Table(0)
);


/******************************************************************************
  STEP E: SCENARIO 2 => E=L1, Z=L2 => CROSS WITH cdfn_lm_dim1 => expansions (X,Y)
******************************************************************************/
/*** Subset dtTop => E="L1",Z="L2" ***/
dtE1Z2_sub = dtTop << Subset(
  Selected Rows(0),
  Rows Where(:E=="L1" & :Z=="L2"),
  Output Table("E1Z2_sub")
);
/*** Join with cdfn_lm_dim1 => includes (C1,D1,F1,N1,L1,M1). ***/
dtE1Z2_cdf = cartJoin(dtE1Z2_sub, cdfn_lm_dim1, "E1Z2_cdfn");

/*** expansions for (X,Y) => same 4 subset+join steps ***/
/* (X=L1,Y=L1) => no expansions */
dtE1Z2_x1y1 = dtE1Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L1"),
  Output Table("E1Z2_x1y1")
);
/* (X=L2,Y=L1) => dtJ */
dtE1Z2_x2y1 = dtE1Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L1"),
  Output Table("E1Z2_x2y1")
);
dtE1Z2_x2y1_J = cartJoin(dtE1Z2_x2y1, dtJ, "E1Z2_x2y1_J");

/* (X=L1,Y=L2) => dtK */
dtE1Z2_x1y2 = dtE1Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L2"),
  Output Table("E1Z2_x1y2")
);
dtE1Z2_x1y2_K = cartJoin(dtE1Z2_x1y2, dtK, "E1Z2_x1y2_K");

/* (X=L2,Y=L2) => dtJK */
dtE1Z2_x2y2 = dtE1Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L2"),
  Output Table("E1Z2_x2y2")
);
dtE1Z2_x2y2_JK = cartJoin(dtE1Z2_x2y2, dtJK, "E1Z2_x2y2_JK");

/*** unify scenario 2 expansions => dtE1Z2_out ***/
dtE1Z2_out = Concatenate(
  dtE1Z2_x1y1,
  dtE1Z2_x2y1_J,
  dtE1Z2_x1y2_K,
  dtE1Z2_x2y2_JK,
  Output Table("E1Z2_out"),
  Append To First Table(0)
);

/******************************************************************************
  STEP F: CONCATENATE SCENARIOS 1 & 2 plus BASE => dtPartial1
     We'll unify dtBaseAll, dtE1Z1_out, dtE1Z2_out into an intermediate table
     that handles E=L1. We'll do E=L2,L3 in Part 3, final unify in Part 4.
******************************************************************************/
dtPartial1 = Concatenate(
  Data Table(dtBaseAll),
  Data Table(dtE1Z1_out),
  Data Table(dtE1Z2_out),
  Output Table("Design_Partial_E1"),
  Append To First Table(0)
);


/******************************************************************************
  ***END OF PART 2***
  We have now:
    - Created dtJ, dtK, dtJK for expansions if X=1 or Y=1.
    - Implemented scenario E=L1,Z=L1 => cdf_dim1 and E=L1,Z=L2 => cdfn_lm_dim1,
      expanded for (X=Y combos).
    - Unified them with dtBaseAll => dtPartial1 (like an intermediate partial).
  Next, in PART 3, we will handle E=L2 scenarios, unify them. 
  Then in PART 4, handle E=L3 & final unify everything. 
******************************************************************************/ 

Names Default To Here(1);

/******************************************************************************
  PART 3 of 4
  -----------
  We now implement SCENARIOS 3 and 4, i.e. (E=L2,Z=L1) and (E=L2,Z=L2).
  The sub-tables cdf_dim2 and cdfn_lm_dim2 were created in Part 1.
  The expansions for (X=1) => dtJ, (Y=1) => dtK, (X=1,Y=1) => dtJK were defined in Part 2.
  We unify their results with dtPartial1 => dtPartial2.

  SCENARIO 3: (E=L2, Z=L1) => cross dtTop subset with cdf_dim2 => expansions for (X,Y).
  SCENARIO 4: (E=L2, Z=L2) => cross dtTop subset with cdfn_lm_dim2 => expansions for (X,Y).
******************************************************************************/


/******************************************************************************
  STEP G: SCENARIO 3 => E=L2, Z=L1 => cross with cdf_dim2 => expansions for X,Y
******************************************************************************/ 
/* Subset dtTop => E="L2" & Z="L1" */
dtE2Z1_sub = dtTop << Subset(
  Selected Rows(0),
  Rows Where(:E=="L2" & :Z=="L1"),
  Output Table("E2Z1_sub")
);
/* Join with cdf_dim2 => (C2,D2,F2) combos */
dtE2Z1_cdf = cartJoin(dtE2Z1_sub, cdf_dim2, "E2Z1_cdf");

/* expansions for (X=...,Y=...) as in earlier scenarios: 
   - X=L1,Y=L1 => no expansions
   - X=L2,Y=L1 => dtJ
   - X=L1,Y=L2 => dtK
   - X=L2,Y=L2 => dtJK
*/

/* (X=L1,Y=L1) => no expansions */
dtE2Z1_x1y1 = dtE2Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L1"),
  Output Table("E2Z1_x1y1")
);

/* (X=L2,Y=L1) => dtJ */
dtE2Z1_x2y1 = dtE2Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L1"),
  Output Table("E2Z1_x2y1")
);
dtE2Z1_x2y1_J = cartJoin(dtE2Z1_x2y1, dtJ, "E2Z1_x2y1_J");

/* (X=L1,Y=L2) => dtK */
dtE2Z1_x1y2 = dtE2Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L2"),
  Output Table("E2Z1_x1y2")
);
dtE2Z1_x1y2_K = cartJoin(dtE2Z1_x1y2, dtK, "E2Z1_x1y2_K");

/* (X=L2,Y=L2) => dtJK */
dtE2Z1_x2y2 = dtE2Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L2"),
  Output Table("E2Z1_x2y2")
);
dtE2Z1_x2y2_JK = cartJoin(dtE2Z1_x2y2, dtJK, "E2Z1_x2y2_JK");

/* unify expansions => dtE2Z1_out */
dtE2Z1_out = Concatenate(
  dtE2Z1_x1y1,
  dtE2Z1_x2y1_J,
  dtE2Z1_x1y2_K,
  dtE2Z1_x2y2_JK,
  Output Table("E2Z1_out"),
  Append To First Table(0)
);


/******************************************************************************
  STEP H: SCENARIO 4 => E=L2, Z=L2 => cdfn_lm_dim2 => expansions for (X,Y)
******************************************************************************/
/* Subset dtTop => E="L2", Z="L2" */
dtE2Z2_sub = dtTop << Subset(
  Selected Rows(0),
  Rows Where(:E=="L2" & :Z=="L2"),
  Output Table("E2Z2_sub")
);
/* Join with cdfn_lm_dim2 => (C2,D2,F2,N2,L2,M2) combos */
dtE2Z2_cdf = cartJoin(dtE2Z2_sub, cdfn_lm_dim2, "E2Z2_cdfn");

/* expansions for X=L1/L2, Y=L1/L2 => 4 subset merges + dtJ/dtK/dtJK as needed */

/* (X=L1,Y=L1) => no expansions */
dtE2Z2_x1y1 = dtE2Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L1"),
  Output Table("E2Z2_x1y1")
);

/* (X=L2,Y=L1) => dtJ */
dtE2Z2_x2y1 = dtE2Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L1"),
  Output Table("E2Z2_x2y1")
);
dtE2Z2_x2y1_J = cartJoin(dtE2Z2_x2y1, dtJ, "E2Z2_x2y1_J");

/* (X=L1,Y=L2) => dtK */
dtE2Z2_x1y2 = dtE2Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L2"),
  Output Table("E2Z2_x1y2")
);
dtE2Z2_x1y2_K = cartJoin(dtE2Z2_x1y2, dtK, "E2Z2_x1y2_K");

/* (X=L2,Y=L2) => dtJK */
dtE2Z2_x2y2 = dtE2Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L2"),
  Output Table("E2Z2_x2y2")
);
dtE2Z2_x2y2_JK = cartJoin(dtE2Z2_x2y2, dtJK, "E2Z2_x2y2_JK");

/* unify scenario 4 expansions => dtE2Z2_out */
dtE2Z2_out = Concatenate(
  dtE2Z2_x1y1,
  dtE2Z2_x2y1_J,
  dtE2Z2_x1y2_K,
  dtE2Z2_x2y2_JK,
  Output Table("E2Z2_out"),
  Append To First Table(0)
);


/******************************************************************************
  STEP I: CONCATENATE SCENARIOS 3 & 4 WITH dtPartial1 => dtPartial2
    dtPartial1 was created in PART 2. We unify dtE2Z1_out, dtE2Z2_out now.
******************************************************************************/
dtPartial2 = Concatenate(
  Data Table(dtPartial1),
  Data Table(dtE2Z1_out),
  Data Table(dtE2Z2_out),
  Output Table("Design_Partial_E2"),
  Append To First Table(0)
);


/******************************************************************************
  ***END OF PART 3***
  We have now appended scenario 3 (E=L2,Z=L1) and scenario 4 (E=L2,Z=L2)
  expansions. The partial table dtPartial2 includes all E=L1 and E=L2 
  plus base. Part 4 will handle E=L3 scenarios (5 & 6), then final unify => dtFinal.
******************************************************************************/ 

Names Default To Here(1);

/******************************************************************************
  PART 4 of 4
  -----------
  We now implement SCENARIOS 5 and 6, i.e. (E=L3,Z=L1) and (E=L3,Z=L2).
  The sub-tables cdf_dim3 and cdfn_lm_dim3 were created in Part 1.
  The expansions for (X=1,Y=1) => dtJ, dtK, dtJK remain the same.
  We'll unify their results with dtPartial2 => dtFinal.
  
  SCENARIO 5: (E=L3,Z=L1) => cross dtTop subset with cdf_dim3 => expansions for (X,Y).
  SCENARIO 6: (E=L3,Z=L2) => cross dtTop subset with cdfn_lm_dim3 => expansions for (X,Y).
******************************************************************************/


/******************************************************************************
  STEP J: SCENARIO 5 => E=L3, Z=L1 => cross with cdf_dim3 => expansions for X,Y
******************************************************************************/
/*** Subset dtTop => E="L3", Z="L1" ***/
dtE3Z1_sub = dtTop << Subset(
  Selected Rows(0),
  Rows Where(:E=="L3" & :Z=="L1"),
  Output Table("E3Z1_sub")
);
/*** Join with cdf_dim3 => (C3,D3,F3) combos ***/
dtE3Z1_cdf = cartJoin(dtE3Z1_sub, cdf_dim3, "E3Z1_cdf");

/*** expansions for (X=...,Y=...) => 4 subsets, each possibly joined with dtJ, dtK, or dtJK ***/
/* (X=L1,Y=L1) => no expansions */
dtE3Z1_x1y1 = dtE3Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L1"),
  Output Table("E3Z1_x1y1")
);
/* (X=L2,Y=L1) => dtJ */
dtE3Z1_x2y1 = dtE3Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L1"),
  Output Table("E3Z1_x2y1")
);
dtE3Z1_x2y1_J = cartJoin(dtE3Z1_x2y1, dtJ, "E3Z1_x2y1_J");

/* (X=L1,Y=L2) => dtK */
dtE3Z1_x1y2 = dtE3Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L2"),
  Output Table("E3Z1_x1y2")
);
dtE3Z1_x1y2_K = cartJoin(dtE3Z1_x1y2, dtK, "E3Z1_x1y2_K");

/* (X=L2,Y=L2) => dtJK */
dtE3Z1_x2y2 = dtE3Z1_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L2"),
  Output Table("E3Z1_x2y2")
);
dtE3Z1_x2y2_JK = cartJoin(dtE3Z1_x2y2, dtJK, "E3Z1_x2y2_JK");

/*** unify scenario 5 expansions => dtE3Z1_out ***/
dtE3Z1_out = Concatenate(
  dtE3Z1_x1y1,
  dtE3Z1_x2y1_J,
  dtE3Z1_x1y2_K,
  dtE3Z1_x2y2_JK,
  Output Table("E3Z1_out"),
  Append To First Table(0)
);


/******************************************************************************
  STEP K: SCENARIO 6 => E=L3, Z=L2 => cdfn_lm_dim3 => expansions for (X,Y)
******************************************************************************/
/*** Subset dtTop => E="L3", Z="L2" ***/
dtE3Z2_sub = dtTop << Subset(
  Selected Rows(0),
  Rows Where(:E=="L3" & :Z=="L2"),
  Output Table("E3Z2_sub")
);
/*** Join with cdfn_lm_dim3 => (C3,D3,F3,N3,L3,M3) combos ***/
dtE3Z2_cdf = cartJoin(dtE3Z2_sub, cdfn_lm_dim3, "E3Z2_cdfn");

/*** expansions for (X=...,Y=...) => same 4 subset merges + dtJ, dtK, dtJK ***/

/* (X=L1,Y=L1) => no expansions */
dtE3Z2_x1y1 = dtE3Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L1"),
  Output Table("E3Z2_x1y1")
);

/* (X=L2,Y=L1) => dtJ */
dtE3Z2_x2y1 = dtE3Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L1"),
  Output Table("E3Z2_x2y1")
);
dtE3Z2_x2y1_J = cartJoin(dtE3Z2_x2y1, dtJ, "E3Z2_x2y1_J");

/* (X=L1,Y=L2) => dtK */
dtE3Z2_x1y2 = dtE3Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L1" & :Y=="L2"),
  Output Table("E3Z2_x1y2")
);
dtE3Z2_x1y2_K = cartJoin(dtE3Z2_x1y2, dtK, "E3Z2_x1y2_K");

/* (X=L2,Y=L2) => dtJK */
dtE3Z2_x2y2 = dtE3Z2_cdf << Subset(
  Selected Rows(0),
  Rows Where(:X=="L2" & :Y=="L2"),
  Output Table("E3Z2_x2y2")
);
dtE3Z2_x2y2_JK = cartJoin(dtE3Z2_x2y2, dtJK, "E3Z2_x2y2_JK");

/*** unify scenario 6 => dtE3Z2_out ***/
dtE3Z2_out = Concatenate(
  dtE3Z2_x1y1,
  dtE3Z2_x2y1_J,
  dtE3Z2_x1y2_K,
  dtE3Z2_x2y2_JK,
  Output Table("E3Z2_out"),
  Append To First Table(0)
);


/******************************************************************************
  STEP L: FINAL CONCATENATION => dtFinal
     We unify dtPartial2 (covers E=L1 & E=L2) with dtE3Z1_out, dtE3Z2_out => dtFinal
******************************************************************************/
dtFinal = Concatenate(
  Data Table(dtPartial2),
  Data Table(dtE3Z1_out),
  Data Table(dtE3Z2_out),
  Output Table("FullDesign_Final"),
  Append To First Table(0)
);

/******************************************************************************
  STEP M: SAVE dtFinal
******************************************************************************/
dtFinal << Save("/Users/alihashim/Desktop/Online_Academic_Submissions/poec_thesis/big_af_branch_design_final.jmp");

/******************************************************************************
  ***END OF PART 4***
  We've added scenario 5 (E=L3,Z=L1) and scenario 6 (E=L3,Z=L2) expansions, 
  then unified with dtPartial2 => dtFinal.
  This script now covers *all* dimension=1..3, Z=0..1, plus expansions for
  X=1 => dtJ or dtJK, Y=1 => dtK or dtJK. 
  That yields complete coverage for your desired interactions:
   (A×B×C×D), (three of {A,B,C,D}+N), 
   (A..I)×X×Y×Z, (Z×L×M×N), 
   (X×Y×Z×{L,M,N}), (X×Y×J×K).
******************************************************************************/ 

