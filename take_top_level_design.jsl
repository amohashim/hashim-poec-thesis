Names Default To Here(1);

/******************************************************************************
  1) OPEN THE TOP-LEVEL DESIGN
     We'll assume the top-level design has columns: A..I (3-level) and X,Y,Z (2-level).
     The path can be changed as needed.
******************************************************************************/
dtTop = Open("/Users/alihashim/Desktop/Online_Academic_Submissions/poec_thesis/top_level_design.jmp");

/******************************************************************************
  1.1) Add new columns for J, K, L, M, N to dtTop
       So that dtTop has placeholders for these sub-factors.
******************************************************************************/
dtTop << New Column("J", Numeric, "Nominal");
dtTop << New Column("K", Numeric, "Nominal");
dtTop << New Column("L", Numeric, "Nominal");
dtTop << New Column("M", Numeric, "Nominal");
dtTop << New Column("N", Numeric, "Nominal");

/******************************************************************************
  2) CREATE SMALL SUB-DESIGN TABLES
     - dtJ (4 combos of J)
     - dtK (4 combos of K)
     - dtJK (16 combos of J,K)
     - dtLMN (64 combos of L,M,N)
******************************************************************************/

/* dtJ */
dtJ = New Table("dtJ",
  Add Rows(4),
  New Column("J", Numeric, "Nominal")
);
For(r=1, r<=4, r++,
  Column(dtJ, "J")[r] = r-1;
);

/* dtK */
dtK = New Table("dtK",
  Add Rows(4),
  New Column("K", Numeric, "Nominal")
);
For(r=1, r<=4, r++,
  Column(dtK, "K")[r] = r-1;
);

/* dtJK => J in 0..3 x K in 0..3 => 16 combos */
dtJK = New Table("dtJK",
  Add Rows(16),
  New Column("J", Numeric, "Nominal"),
  New Column("K", Numeric, "Nominal")
);
idx=1;
For(j=0, j<4, j++,
  For(k=0, k<4, k++,
    Column(dtJK, "J")[idx] = j;
    Column(dtJK, "K")[idx] = k;
    idx++;
  )
);

/* dtLMN => L,M,N each in 0..3 => 64 combos */
dtLMN = New Table("dtLMN",
  Add Rows(64),
  New Column("L", Numeric, "Nominal"),
  New Column("M", Numeric, "Nominal"),
  New Column("N", Numeric, "Nominal")
);
idx = 1;
For(l=0, l<4, l++,
  For(m=0, m<4, m++,
    For(n=0, n<4, n++,
      Column(dtLMN, "L")[idx] = l;
      Column(dtLMN, "M")[idx] = m;
      Column(dtLMN, "N")[idx] = n;
      idx++;
    )
  )
);

/******************************************************************************
  3) CREATE A "BASE TABLE" => copy dtTop (1536 x ???)
     This is the union approach's baseline: every top-level row is included once
     with no sub-factor expansions.
******************************************************************************/
dtBaseAll = dtTop << Subset(
  Selected Rows( 0 ),
  Output Table("BaseAll")
);

/******************************************************************************
  4) SUBSET dtTop FOR EACH (X,Y,Z) COMBINATION, THEN CROSS WITH THE APPROPRIATE
     SUB-DESIGN TABLE(S).

  We'll define 8 subsets:
    1) X=0, Y=0, Z=0 => no expansions
    2) X=1, Y=0, Z=0 => dtJ
    3) X=0, Y=1, Z=0 => dtK
    4) X=0, Y=0, Z=1 => dtLMN
    5) X=1, Y=1, Z=0 => dtJK
    6) X=1, Y=0, Z=1 => cross dtJ with dtLMN => 4x64=256
    7) X=0, Y=1, Z=1 => cross dtK with dtLMN => 4x64=256
    8) X=1, Y=1, Z=1 => cross dtJK with dtLMN => 16x64=1024
******************************************************************************/

/* We'll define a helper function to create subsets easily */
newSubset = Function({dt, condition, name},
  Return( dt << Subset(
    Selected Rows(0),
    Rows Where(condition),
    Output Table(name)
  ))
);

/* We'll define a helper to do a cartesian join in JMP: returns new table */
cartJoin = Function({dtA, dtB, outName},
  Return( dtA << Join(
    With(dtB),
    Type("Cartesian"),
    Output Table(outName)
  ))
);

/* We also define a function to do a "double cross" => cross dtA with dtB and dtC
   We do it by first cartJoin dtA & dtB => dtAB, then cartJoin dtAB & dtC => dtABC
   Because JMP doesn't have a direct triple cross in one command.
*/
doubleCross = Function({dtBase, dtB, dtC, outName},
  // 1) cross dtBase with dtB
  tempName = outName || " Temp1";
  dtAB = dtBase << Join(
    With(dtB),
    Type("Cartesian"),
    Output Table(tempName)
  );
  // 2) cross dtAB with dtC
  dtABC = dtAB << Join(
    With(dtC),
    Type("Cartesian"),
    Output Table(outName)
  );
  Return(dtABC);
);

/* (1) X=0, Y=0, Z=0 => no expansions => just do nothing special
   The base rows are already included in dtBaseAll
*/

/* (2) X=1, Y=0, Z=0 => cross with dtJ */
dtX1Y0Z0 = newSubset(dtTop, (:X=="1" & :Y=="0" & :Z=="0"), "X1Y0Z0");
dtX1Y0Z0_J = cartJoin(dtX1Y0Z0, dtJ, "X1Y0Z0_J");

/* (3) X=0, Y=1, Z=0 => cross with dtK */
dtX0Y1Z0 = newSubset(dtTop, (:X=="0" & :Y=="1" & :Z=="0"), "X0Y1Z0");
dtX0Y1Z0_K = cartJoin(dtX0Y1Z0, dtK, "X0Y1Z0_K");

/* (4) X=0, Y=0, Z=1 => cross with dtLMN */
dtX0Y0Z1 = newSubset(dtTop, (:X=="0" & :Y=="0" & :Z=="1"), "X0Y0Z1");
dtX0Y0Z1_LMN = cartJoin(dtX0Y0Z1, dtLMN, "X0Y0Z1_LMN");

/* (5) X=1, Y=1, Z=0 => cross with dtJK */
dtX1Y1Z0 = newSubset(dtTop, (:X=="1" & :Y=="1" & :Z=="0"), "X1Y1Z0");
dtX1Y1Z0_JK = cartJoin(dtX1Y1Z0, dtJK, "X1Y1Z0_JK");

/* (6) X=1, Y=0, Z=1 => cross dtJ & dtLMN => 4x64=256 per row */
dtX1Y0Z1 = newSubset(dtTop, (:X=="1" & :Y=="0" & :Z=="1"), "X1Y0Z1");
dtX1Y0Z1_JLMN = doubleCross(dtX1Y0Z1, dtJ, dtLMN, "X1Y0Z1_JLMN");

/* (7) X=0, Y=1, Z=1 => cross dtK & dtLMN => 4x64=256 per row */
dtX0Y1Z1 = newSubset(dtTop, (:X=="0" & :Y=="1" & :Z=="1"), "X0Y1Z1");
dtX0Y1Z1_KLMN = doubleCross(dtX0Y1Z1, dtK, dtLMN, "X0Y1Z1_KLMN");

/* (8) X=1, Y=1, Z=1 => cross dtJK & dtLMN => 16x64=1024 per row */
dtX1Y1Z1 = newSubset(dtTop, (:X=="1" & :Y=="1" & :Z=="1"), "X1Y1Z1");
dtX1Y1Z1_JKLMN = doubleCross(dtX1Y1Z1, dtJK, dtLMN, "X1Y1Z1_JKLMN");

/******************************************************************************
  5) CONCATENATE EVERYTHING => final table
     - dtBaseAll => base top-level only
     - dtX1Y0Z0_J
     - dtX0Y1Z0_K
     - dtX0Y0Z1_LMN
     - dtX1Y1Z0_JK
     - dtX1Y0Z1_JLMN
     - dtX0Y1Z1_KLMN
     - dtX1Y1Z1_JKLMN
******************************************************************************/
dtFinal = Concatenate(
  Data Table(dtBaseAll),
  Data Table(dtX1Y0Z0_J),
  Data Table(dtX0Y1Z0_K),
  Data Table(dtX0Y0Z1_LMN),
  Data Table(dtX1Y1Z0_JK),
  Data Table(dtX1Y0Z1_JLMN),
  Data Table(dtX0Y1Z1_KLMN),
  Data Table(dtX1Y1Z1_JKLMN),
  Output Table("FullDesign_Expanded"),
  Append To First Table(0)
);

/******************************************************************************
  6) SAVE THE FINAL TABLE
******************************************************************************/
dtFinal << Save("/Users/alihashim/Desktop/Online_Academic_Submissions/poec_thesis/final_design_expanded.jmp");

/******************************************************************************
  SCRIPT COMPLETE
  Explanation:
  - We now do a full cross for each (X,Y,Z) condition, e.g. if (X=1,Y=0,Z=1)
    => cross dtJ & dtLMN => 4x64=256 expansions per top-level row.
  - If (X=1,Y=1,Z=1), we get 16x64=1024 expansions per row => big coverage for J,K,L,M,N
  - This drastically increases the total row count, improving precision for sub-factors.
*****************************************************************************/
